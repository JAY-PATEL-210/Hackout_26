rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (request.auth.token.email.matches('.*manager.*') ? 'manager'
          : (request.auth.token.email.matches('.*tech.*') ? 'technician' : 'user'));
    }
    
    function hasRole(roleName) {
      return isAuthenticated() && (getUserRole() == roleName || getUserRole() == 'manager');
    }

    // 1. Renewable Assets & Turbines collections
    match /renewable_assets/{assetId} {
      allow read: if true;
      allow write: if false;

      match /telemetry_logs/{logId} {
        allow read: if true;
        allow write: if false;
      }
      match /maintenance_records/{recId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && hasRole('technician');
        allow delete: if false;
      }
    }

    match /turbines/{turbineId} {
      allow read: if true;
      allow write: if false;

      match /readings/{readingId} {
        allow read: if true;
        allow write: if false;
      }

      match /maintenance_log/{entryId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && hasRole('technician');
        allow delete: if false;
      }
    }

    // 2. Top-Level Work Orders
    match /work_orders/{orderId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && hasRole('technician');
      allow delete: if false;
    }

    // 3. Simulation & SCADA Stream State
    match /simulation_state/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Model Metrics & Analytics
    match /model_metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /ai_model_metrics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 5. Fleet Summary & Analytics
    match /fleet_summary/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /fleet_analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
